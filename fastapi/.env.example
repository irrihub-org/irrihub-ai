DATABASE_URL=postgresql://irrihub:devpassword@localhost:5432/irrihub_db
CHATWOOT_BASE_URL=http://chatwoot-app:3000
CHATWOOT_API_TOKEN=your_chatwoot_token
OPENROUTER_API_KEY=your_openrouter_key
# Comma-separated priority list. If a model 404s/429s/503s, the next
# one in the list is tried automatically. (OPENROUTER_MODEL, a single
# model name, is still supported for backward compatibility.)
OPENROUTER_MODELS=meta-llama/llama-3.1-8b-instruct,google/gemma-4-31b-it:free
# Cheaper/faster models used only for the escalation-intent classifier
# call (not the main answer). Falls back to OPENROUTER_MODELS if unset.
OPENROUTER_CLASSIFIER_MODELS=google/gemma-4-31b-it:free,meta-llama/llama-3.1-8b-instruct
ENVIRONMENT=development
LOG_LEVEL=debug

# Where escalated conversations are sent as CRM leads. The token must
# match CHATWOOT_LEAD_WEBHOOK_TOKEN in the CRM's own .env, or the
# endpoint returns 401 and every lead is dropped (logged, not raised).
CRM_BASE_URL=http://irrihub-app
CHATWOOT_LEAD_WEBHOOK_TOKEN=
